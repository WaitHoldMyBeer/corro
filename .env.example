# Copy to .env (gitignored) and fill in. Nothing here is a secret.

# Clio developer application (https://developers.clio.com). Read scopes are enough:
# the app only ever sends GET requests to the Clio API.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
# Must match a redirect URI registered on the Clio developer application.
CLIO_REDIRECT_URI=http://127.0.0.1:8000/oauth/callback
# Region host: app.clio.com (US), eu.app.clio.com, ca.app.clio.com, au.app.clio.com
CLIO_BASE_URL=https://app.clio.com

# Optional: the Clio matter id to open by default. Leave empty to pick from the
# list the app reads from Clio (`uv run python -m server matters`).
CLIO_MATTER_ID=

# The digest (reading documents, reconciling notes against them) runs on OpenAI.
OPENAI_API_KEY=
# Model ids are configuration, not code. DIGEST_MODEL does reconciliation and the
# summary; DIGEST_MODEL_BULK does per-page extraction (defaults to DIGEST_MODEL).
DIGEST_MODEL=
DIGEST_MODEL_BULK=
# Model for the live checker's tier 2; defaults to DIGEST_MODEL_BULK.
CHECK_MODEL=
# Reasoning effort for the live checker's model call; `none` measured fastest with no loss on our evaluation set.
CHECK_EFFORT=
# Passcode for the firm's side of the app (everything except a provider's own link).
FIRM_PASSCODE=
# Hours a matter must sit unopened before the next open is a new visit (moves the "since you last opened" marker).
VISIT_GAP_HOURS=
# IANA time zone the firm works in (for "today", overdue and coming). Defaults to this machine's.
FIRM_TIMEZONE=

# Where SQLite, OAuth tokens and downloaded document bytes live (gitignored).
SWANS_DATA_DIR=data
